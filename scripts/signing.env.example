# Local-only signing/notarization settings for build-app.sh.
# Copy to signing.env and fill in your real values. This file is gitignored
# so your Developer ID and Keychain profile stay off the repo.
#
#   SIGN_IDENTITY="Developer ID Application: Your Name (TEAMID)"
#   TEAM_ID="TEAMID"
#   NOTARY_PROFILE="notary-profile"
#   NOTARIZE=1
#
# Create the notarytool Keychain profile once:
#   xcrun notarytool store-credentials "notary-profile" \
#     --apple-id "you@example.com" \
#     --team-id "TEAMID" \
#     --password "app-specific-password"
